# ============================================
# BASE DE DATOS - NEON PostgreSQL
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/clima_reus_hvac"

# ============================================
# NEXTAUTH - AUTENTICACIÓN
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_PROVIDERS_GOOGLE_ID=your-google-client-id
NEXTAUTH_PROVIDERS_GOOGLE_SECRET=your-google-client-secret

# ============================================
# BASE DE DATOS - NEON (Alternativa a PostgreSQL local)
# ============================================
# Descomenta si usas Neon
# DATABASE_URL="postgresql://neon_user:neon_password@ep-xxx.neon.tech/clima_reus_hvac?sslmode=require"

# ============================================
# APLICACIÓN
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Clima Reus HVAC
NEXT_PUBLIC_APP_URL=http://localhost:3000
