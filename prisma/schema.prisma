// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS - Estados y Tipos
// ============================================

enum UserRole {
  admin
  cliente
  trabajador
}

enum OrderStatus {
  pendiente
  confirmada
  en_progreso
  completada
  cancelada
}

enum PaymentStatus {
  pendiente
  pagado
  fallido
  reembolsado
}

enum TaskStatus {
  pendiente
  en_progreso
  completada
  cancelada
}

enum ServiceRequestStatus {
  nueva
  en_revision
  presupuestada
  asignada
  en_camino
  completada
  tomada
  resuelta
  cancelada
}

// ============================================
// USUARIOS
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  password          String
  firstName         String
  lastName          String
  phoneNumber       String?
  address           String?
  city              String?
  postalCode        String?
  country           String?
  role              UserRole  @default(cliente)
  profileImageUrl   String?
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  rememberTokenHash        String?
  lastLoginAt              DateTime?
  requiresPasswordChange   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relaciones
  accounts          Account[]
  sessions          Session[]
  cliente           Cliente?
  trabajador        Trabajador?
  orders            Order[]
  tasks             Task[]
  taskComments      TaskComment[]
  notifications     Notification[]
  serviceRequests   ServiceRequest[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([username])
  @@index([role])
}

// ============================================
// AUTENTICACIÓN - NextAuth.js
// ============================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String   @default("email_verification")
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

// ============================================
// CLIENTES
// ============================================

model Cliente {
  id                  String    @id @default(cuid())
  userId              String    @unique
  companyName         String?
  businessRegNumber   String?
  totalOrders         Int       @default(0)
  totalSpent          Decimal   @default(0) @db.Decimal(10, 2)
  averageRating       Decimal?  @db.Decimal(3, 2)
  preferredLanguage   String    @default("es")
  isBlacklisted       Boolean   @default(false)
  blacklistedReason   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders              Order[]
  addresses           ClientAddress[]
  reviews             Review[]

  @@index([userId])
}

model ClientAddress {
  id              String    @id @default(cuid())
  clienteId       String
  label           String    @default("principal")
  street          String
  city            String
  state           String?
  postalCode      String
  country         String
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relaciones
  cliente         Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([clienteId])
}

// ============================================
// TRABAJADORES
// ============================================

model Trabajador {
  id                  String    @id @default(cuid())
  userId              String    @unique
  specialties         String[]  @default([])
  certifications      String[]  @default([])
  yearsExperience     Int       @default(0)
  isAvailable         Boolean   @default(true)
  availability        String?   // JSON con horarios de disponibilidad
  hourlyRate          Decimal?  @db.Decimal(8, 2)
  averageRating       Decimal?  @db.Decimal(3, 2)
  totalJobsCompleted  Int       @default(0)
  verificationStatus  String    @default("pending") // pending, verified, rejected
  verificationDate    DateTime?
  documents           String[]  @default([]) // URLs de certificados y documentos
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews             Review[]
  assignedRequests    ServiceRequest[]

  @@index([userId])
  @@index([isAvailable])
  @@index([verificationStatus])
}

// ============================================
// PRODUCTOS
// ============================================

model Product {
  id                  String    @id @default(cuid())
  name                String
  description         String    @db.Text
  shortDescription    String?
  category            String    // kept for legacy
  categoryId          String?
  sku                 String    @unique
  manufacturer        String?
  modelNumber         String?
  price               Decimal   @db.Decimal(10, 2)
  discountPrice       Decimal?  @db.Decimal(10, 2)
  stock               Int       @default(0)
  minStock            Int       @default(5)
  maxStock            Int       @default(100)
  images              String[]  @default([]) // URLs de imágenes
  specifications      String?   @db.Text // JSON con especificaciones técnicas
  warranty            String?   // ej: "2 años"
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  productCategory     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  servicePackages     ServicePackage[]

  @@index([category])
  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
}

// ============================================
// CATEGORÍAS DE PRODUCTOS
// ============================================

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

// ============================================
// SERVICIOS DE INSTALACIÓN
// ============================================

model Service {
  id                  String    @id @default(cuid())
  name                String
  description         String    @db.Text
  type                String    // instalacion, mantenimiento, reparacion
  basePrice           Decimal   @db.Decimal(10, 2)
  estimatedDuration   Int       // en minutos
  difficulty          String    @default("media") // baja, media, alta
  requirements        String[]  @default([]) // Herramientas y materiales requeridos
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  servicePackages     ServicePackage[]

  @@index([type])
  @@index([isActive])
}

// ============================================
// PAQUETES DE SERVICIO (Producto + Servicio)
// ============================================

model ServicePackage {
  id                  String    @id @default(cuid())
  name                String
  description         String    @db.Text
  productId           String
  serviceId           String
  packagePrice        Decimal   @db.Decimal(10, 2)
  discountPercentage  Decimal?  @db.Decimal(5, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  service             Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]

  @@unique([productId, serviceId])
  @@index([productId])
  @@index([serviceId])
}

// ============================================
// PEDIDOS
// ============================================

model Order {
  id                  String    @id @default(cuid())
  orderNumber         String    @unique
  userId              String
  clientId            String
  addressId           String
  status              OrderStatus @default(pendiente)
  paymentStatus       PaymentStatus @default(pendiente)
  subtotal            Decimal   @db.Decimal(10, 2)
  taxAmount           Decimal   @db.Decimal(10, 2)
  shippingCost        Decimal   @db.Decimal(10, 2)
  totalAmount         Decimal   @db.Decimal(10, 2)
  installationRequired Boolean   @default(false)
  notes               String?   @db.Text
  scheduledDate       DateTime?
  completedDate       DateTime?
  cancelledDate       DateTime?
  cancelledReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  cliente             Cliente   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  address             ClientAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payment             Payment?
  task                Task?
  statusHistory       OrderStatusHistory[]
  invoices            Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  productId           String?
  servicePackageId    String?
  quantity            Int       @default(1)
  unitPrice           Decimal   @db.Decimal(10, 2)
  discount            Decimal   @default(0) @db.Decimal(10, 2)
  totalPrice          Decimal   @db.Decimal(10, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  servicePackage      ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id                  String    @id @default(cuid())
  orderId             String
  previousStatus      OrderStatus
  newStatus           OrderStatus
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())

  // Relaciones
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ============================================
// PAGOS
// ============================================

model Payment {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("EUR")
  paymentMethod       String    // tarjeta, transferencia, etc.
  transactionId       String?   @unique
  status              PaymentStatus @default(pendiente)
  failureReason       String?
  paidAt              DateTime?
  refundedAt          DateTime?
  refundAmount        Decimal?  @db.Decimal(10, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ============================================
// FACTURAS
// ============================================

model Invoice {
  id                  String    @id @default(cuid())
  orderId             String
  invoiceNumber       String    @unique
  issueDate           DateTime  @default(now())
  dueDate             DateTime
  paidDate            DateTime?
  totalAmount         Decimal   @db.Decimal(10, 2)
  taxAmount           Decimal   @db.Decimal(10, 2)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([invoiceNumber])
}

// ============================================
// TAREAS PARA TRABAJADORES
// ============================================

model Task {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  assignedToId        String?
  status              TaskStatus @default(pendiente)
  priority            String    @default("media") // baja, media, alta
  description         String    @db.Text
  startDate           DateTime?
  endDate             DateTime?
  completedAt         DateTime?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo          User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  comments            TaskComment[]

  @@index([orderId])
  @@index([assignedToId])
  @@index([status])
}

model TaskComment {
  id                  String    @id @default(cuid())
  taskId              String
  authorId            String
  content             String    @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author              User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

// ============================================
// RESEÑAS Y CALIFICACIONES
// ============================================

model Review {
  id                  String    @id @default(cuid())
  orderId             String?
  clienteId           String
  trabajadorId        String?
  rating              Int       // 1-5 estrellas
  title               String
  comment             String    @db.Text
  helpful             Int       @default(0)
  unhelpful           Int       @default(0)
  verified            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  trabajador          Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([trabajadorId])
  @@index([rating])
}

// ============================================
// NOTIFICACIONES
// ============================================

model Notification {
  id                  String    @id @default(cuid())
  userId              String
  type                String    // order_status, payment, etc.
  title               String
  message             String    @db.Text
  relatedId           String?   // ID del pedido, tarea, etc.
  isRead              Boolean   @default(false)
  readAt              DateTime?
  createdAt           DateTime  @default(now())

  // Relaciones
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// AUDITORÍA
// ============================================

// ============================================
// SOLICITUDES DE VISITA (sin registro)
// ============================================

model ServiceRequest {
  id          String               @id @default(cuid())
  number      Int                  @unique @default(autoincrement())
  name        String
  phone       String
  description String               @db.Text
  status      ServiceRequestStatus @default(nueva)
  takenById        String?
  takenAt          DateTime?
  assignedToId     String?
  assignedAt       DateTime?
  budget           Decimal?             @db.Decimal(10, 2)
  budgetNotes      String?              @db.Text
  adminNotes       String?              @db.Text
  clientEmail      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  takenBy          User?                @relation(fields: [takenById], references: [id], onDelete: SetNull)
  assignedTo       Trabajador?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([takenById])
  @@index([createdAt])
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// AUDITORÍA
// ============================================

model AuditLog {
  id                  String    @id @default(cuid())
  userId              String?
  action              String    // create, update, delete
  entityType          String    // User, Order, Product, etc.
  entityId            String
  changes             String?   @db.Text // JSON con cambios
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
